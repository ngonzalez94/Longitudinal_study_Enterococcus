library(readxl)
library(dplyr)
library(tidyr)
library(stringr)
library(readxl)
df <- read_xlsx("amrfinder_faecium.xlsx")
df <- read_xlsx("amrfinder_faecium.xlsx")
# Normalise column names (trim whitespace)
names(df) <- trimws(names(df))
# Keep only AMR rows (ignore STRESS, VIRULENCE, etc. if present)
df <- df %>% filter(Type == "AMR")
# -----------------------------------------------------------------------------
# 2. Build a per-contig gene table
#    Key columns: Sample (isolate), ContigID, Gene symbol, Class
# -----------------------------------------------------------------------------
contig_genes <- df %>%
select(Sample, ContigID, gene = `Gene symbol`, class = Class) %>%
distinct()
# -----------------------------------------------------------------------------
# 3. For every contig that carries ≥2 genes, collapse into a gene-combination
#    row, keeping track of which AMR classes those genes belong to.
# -----------------------------------------------------------------------------
contig_combos <- contig_genes %>%
group_by(Sample, ContigID) %>%
summarise(
n_genes        = n_distinct(gene),
gene_combo     = paste(sort(unique(gene)),  collapse = " | "),
class_combo    = paste(sort(unique(class)), collapse = " | "),
.groups = "drop"
) %>%
filter(n_genes >= 2)   # only contigs that co-carry multiple AMR genes
# -----------------------------------------------------------------------------
# 4. Count isolates per gene combination
# -----------------------------------------------------------------------------
total_isolates <- n_distinct(df$Sample)
summary_table <- contig_combos %>%
group_by(gene_combo, class_combo) %>%
summarise(
n_isolates   = n_distinct(Sample),
.groups      = "drop"
) %>%
mutate(
pct          = round(n_isolates / total_isolates * 100, 1),
fraction     = paste0(n_isolates, "/", total_isolates)
) %>%
arrange(desc(n_isolates)) %>%
rename(
`Gene combination`  = gene_combo,
`AMR class(es)`     = class_combo,
`N isolates`        = n_isolates,
`% isolates`        = pct,
`Fraction (n/N)`    = fraction
)
# -----------------------------------------------------------------------------
# 5. Print results
# -----------------------------------------------------------------------------
cat("\n=== AMR gene co-occurrence on the same contig ===\n")
cat("Total isolates in dataset:", total_isolates, "\n\n")
print(summary_table, n = Inf)
# -----------------------------------------------------------------------------
# 6. (Optional) Export to TSV
# -----------------------------------------------------------------------------
write.table(summary_table,
file      = "amr_contig_cooccurrence_results.tsv",
sep       = "\t",
quote     = FALSE,
row.names = FALSE)
cat("\nResults saved to: amr_contig_cooccurrence_results.tsv\n")
# -----------------------------------------------------------------------------
# 1. Load data
#    The file has a compound first column: "filename,Protein id"
#    e.g. "NG0016bc_contigs_amr.tsv,NA"
#    We read everything as raw text, then parse.
# -----------------------------------------------------------------------------
setwd("C:/Users/ngonzalez/OneDrive - Massey University/Thesis/Chapter 2 - Longitudinal Study/Enterococcus/faecium/fixed_analysis")
# ---- Option A: single concatenated file (as shown in your example) ----------
raw <- read.delim("amr_faecium.tsv",
sep       = "\t",
header    = TRUE,
stringsAsFactors = FALSE,
check.names = FALSE)
# The first column contains "filename,ProteinID" — split it
first_col <- names(raw)[1]   # e.g. "NG0016bc_contigs_amr.tsv,Protein id"
# Extract isolate name from the filename prefix (everything before "_contigs")
raw <- raw %>%
mutate(
isolate = str_extract(.[[1]], "^[^,]+"),          # grab filename portion
isolate = tools::file_path_sans_ext(isolate),     # drop .tsv extension
isolate = str_remove(isolate, "_contigs_amr$")    # clean suffix
)
# Keep only AMR rows and relevant columns
df <- raw %>%
filter(Type == "AMR") %>%
select(isolate, gene = `Element symbol`) %>%
distinct()
# -----------------------------------------------------------------------------
# 2. Build presence / absence matrix
#    1  = gene present in that isolate
#    -1 = gene absent  in that isolate
# -----------------------------------------------------------------------------
pa_matrix <- df %>%
mutate(present = 1L) %>%
pivot_wider(
names_from  = gene,
values_from = present,
values_fill = -1L          # fill missing = absent
) %>%
arrange(isolate)
# -----------------------------------------------------------------------------
# 3. Print
# -----------------------------------------------------------------------------
cat("\n=== AMR Gene Presence / Absence Matrix (1 = present, -1 = absent) ===\n")
cat("Isolates:", nrow(pa_matrix), "\n")
cat("Genes   :", ncol(pa_matrix) - 1, "\n\n")
print(pa_matrix)
# -----------------------------------------------------------------------------
# 4. Export
# -----------------------------------------------------------------------------
write.table(pa_matrix,
file      = "amr_presence_absence_matrix.tsv",
sep       = "\t",
quote     = FALSE,
row.names = FALSE)
cat("\nSaved to: amr_presence_absence_matrix.tsv\n")
